# Used by /api/contact and /api/newsletter routes (optional).
# Wire these up to your provider (Resend, SendGrid, Mailchimp, etc.) in the route handlers.
RESEND_API_KEY=
NEWSLETTER_AUDIENCE_ID=
CONTACT_TO_EMAIL=hello@example.com

# --- Accounts & course progress (Auth.js + Prisma) ---

# Database. SQLite for local dev; use a Postgres connection string in production
# (and change `provider` in prisma/schema.prisma from "sqlite" to "postgresql").
DATABASE_URL="file:./dev.db"

# Session secret. Generate with: npx auth secret
AUTH_SECRET=

# Base URL used to build password-reset links.
APP_URL="http://localhost:3000"

# Email "from" address for password-reset messages (uses RESEND_API_KEY above).
EMAIL_FROM="FFI Courses <no-reply@ffiaz.info>"

# First admin account, created by `npm run db:seed`.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
